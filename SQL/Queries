-- 59. Identify high-revenue and high-profit categories
SELECT
    p.Category,
    ROUND(SUM(oi.Net_Revenue), 2) AS revenue,
    ROUND(SUM(oi.Gross_Profit), 2) AS profit
FROM order_items oi
JOIN orders o ON oi.Order_ID = o.Order_ID
JOIN products p ON oi.Product_ID = p.Product_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY p.Category
HAVING SUM(oi.Net_Revenue) >
    (
        SELECT AVG(category_revenue)
        FROM (
            SELECT SUM(oi2.Net_Revenue) AS category_revenue
            FROM order_items oi2
            JOIN orders o2 ON oi2.Order_ID = o2.Order_ID
            JOIN products p2 ON oi2.Product_ID = p2.Product_ID
            WHERE o2.Order_Status = 'Delivered'
            GROUP BY p2.Category
        ) AS category_average
    )
ORDER BY profit DESC;

-- 60. High-value customers
SELECT
    Customer_ID,
    frequency,
    monetary,
    recency
FROM customer_rfm
WHERE monetary >= (
    SELECT AVG(monetary)
    FROM customer_rfm
)
ORDER BY monetary DESC;

-- 61. Products with strong sales but low remaining inventory
WITH latest_inventory AS (
    SELECT
        Product_ID,
        MAX(Snapshot_Month) AS latest_month
    FROM inventory
    GROUP BY Product_ID
),
sales AS (
    SELECT
        oi.Product_ID,
        SUM(oi.Quantity) AS total_units_sold
    FROM order_items oi
    JOIN orders o ON oi.Order_ID = o.Order_ID
    WHERE o.Order_Status = 'Delivered'
    GROUP BY oi.Product_ID
)
SELECT
    p.Product_ID,
    p.Category,
    s.total_units_sold,
    i.Closing_Stock
FROM products p
JOIN sales s ON p.Product_ID = s.Product_ID
JOIN latest_inventory li ON p.Product_ID = li.Product_ID
JOIN inventory i
    ON i.Product_ID = li.Product_ID
   AND i.Snapshot_Month = li.latest_month
WHERE i.Closing_Stock < 20
ORDER BY s.total_units_sold DESC;

-- 62. Revenue and profitability by age group
SELECT
    CASE
        WHEN c.Age < 20 THEN 'Below 20'
        WHEN c.Age BETWEEN 20 AND 29 THEN '20-29'
        WHEN c.Age BETWEEN 30 AND 39 THEN '30-39'
        WHEN c.Age BETWEEN 40 AND 49 THEN '40-49'
        ELSE '50+'
    END AS age_group,
    COUNT(DISTINCT c.Customer_ID) AS customers,
    ROUND(SUM(oi.Net_Revenue), 2) AS revenue,
    ROUND(SUM(oi.Gross_Profit), 2) AS profit
FROM customers c
JOIN orders o ON c.Customer_ID = o.Customer_ID
JOIN order_items oi ON o.Order_ID = oi.Order_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY age_group
ORDER BY revenue DESC;

-- 63. Monthly revenue by category
SELECT
    DATE_FORMAT(o.Order_Date, '%Y-%m') AS sales_month,
    p.Category,
    ROUND(SUM(oi.Net_Revenue), 2) AS revenue
FROM orders o
JOIN order_items oi ON o.Order_ID = oi.Order_ID
JOIN products p ON oi.Product_ID = p.Product_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY sales_month, p.Category
ORDER BY sales_month, revenue DESC;

-- 64. Average selling price by category
SELECT
    p.Category,
    ROUND(
        SUM(oi.Net_Revenue) /
        NULLIF(SUM(oi.Quantity), 0),
        2
    ) AS average_selling_price
FROM order_items oi
JOIN orders o ON oi.Order_ID = o.Order_ID
JOIN products p ON oi.Product_ID = p.Product_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY p.Category
ORDER BY average_selling_price DESC;

-- 65. Promotion performance by category
SELECT
    pr.Promotion_Type,
    p.Category,
    COUNT(DISTINCT o.Order_ID) AS total_orders,
    ROUND(SUM(oi.Net_Revenue), 2) AS revenue,
    ROUND(SUM(oi.Gross_Profit), 2) AS profit
FROM orders o
JOIN order_items oi ON o.Order_ID = oi.Order_ID
JOIN products p ON oi.Product_ID = p.Product_ID
JOIN promotions pr ON o.Promotion_ID = pr.Promotion_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY pr.Promotion_Type, p.Category
ORDER BY revenue DESC;


