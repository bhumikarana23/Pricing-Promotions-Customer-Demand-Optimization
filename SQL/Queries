-- 53. Latest inventory snapshot by product
WITH latest_inventory AS (
    SELECT
        Product_ID,
        MAX(Snapshot_Month) AS latest_month
    FROM inventory
    GROUP BY Product_ID
)
SELECT
    i.Product_ID,
    p.Category,
    i.Snapshot_Month,
    i.Opening_Stock,
    i.Stock_Received,
    i.Units_Sold,
    i.Closing_Stock
FROM inventory i
JOIN latest_inventory li
    ON i.Product_ID = li.Product_ID
   AND i.Snapshot_Month = li.latest_month
JOIN products p
    ON i.Product_ID = p.Product_ID
ORDER BY i.Closing_Stock ASC;

-- 54. Inventory by category
SELECT
    p.Category,
    SUM(i.Opening_Stock) AS opening_stock,
    SUM(i.Stock_Received) AS stock_received,
    SUM(i.Units_Sold) AS units_sold,
    SUM(i.Closing_Stock) AS closing_stock
FROM inventory i
JOIN products p ON i.Product_ID = p.Product_ID
GROUP BY p.Category
ORDER BY units_sold DESC;

-- 55. Products with low closing stock
SELECT
    i.Product_ID,
    p.Brand,
    p.Category,
    i.Snapshot_Month,
    i.Closing_Stock,
    i.Units_Sold
FROM inventory i
JOIN products p ON i.Product_ID = p.Product_ID
WHERE i.Closing_Stock <= 10
ORDER BY i.Closing_Stock ASC;

-- 56. Monthly demand trends by category
SELECT
    i.Snapshot_Month,
    p.Category,
    SUM(i.Units_Sold) AS total_demand
FROM inventory i
JOIN products p ON i.Product_ID = p.Product_ID
GROUP BY i.Snapshot_Month, p.Category
ORDER BY i.Snapshot_Month, total_demand DESC;

-- 57. Inventory turnover ratio
SELECT
    p.Category,
    ROUND(
        SUM(i.Units_Sold) /
        NULLIF(AVG(i.Opening_Stock + i.Closing_Stock) / 2, 0),
        2
    ) AS inventory_turnover_ratio
FROM inventory i
JOIN products p ON i.Product_ID = p.Product_ID
GROUP BY p.Category
ORDER BY inventory_turnover_ratio DESC;

-- 58. Monthly product demand ranking
WITH product_demand AS (
    SELECT
        i.Snapshot_Month,
        i.Product_ID,
        SUM(i.Units_Sold) AS total_units_sold
    FROM inventory i
    GROUP BY i.Snapshot_Month, i.Product_ID
)
SELECT
    Snapshot_Month,
    Product_ID,
    total_units_sold,
    DENSE_RANK() OVER (
        PARTITION BY Snapshot_Month
        ORDER BY total_units_sold DESC
    ) AS demand_rank
FROM product_demand
ORDER BY Snapshot_Month, demand_rank;


