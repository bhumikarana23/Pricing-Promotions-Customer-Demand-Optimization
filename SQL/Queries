-- 27. Discount band analysis
SELECT
    CASE
        WHEN Discount_Rate = 0 THEN 'No Discount'
        WHEN Discount_Rate <= 0.10 THEN '0-10%'
        WHEN Discount_Rate <= 0.20 THEN '10-20%'
        WHEN Discount_Rate <= 0.30 THEN '20-30%'
        WHEN Discount_Rate <= 0.40 THEN '30-40%'
        ELSE 'Above 40%'
    END AS discount_band,
    COUNT(*) AS total_items,
    SUM(Quantity) AS units_sold,
    ROUND(SUM(Net_Revenue), 2) AS revenue,
    ROUND(SUM(Gross_Profit), 2) AS profit
FROM order_items oi
JOIN orders o ON oi.Order_ID = o.Order_ID
WHERE o.Order_Status = 'Delivered'
GROUP BY discount_band
ORDER BY MIN(Discount_Rate);

